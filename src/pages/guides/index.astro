---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import ExitPopup from '../../components/ExitPopup.astro';
import { getCollection } from 'astro:content';
import { BookOpen, Clock, ChevronRight, User } from 'lucide-astro';
import { currentYear, injectCurrentYear } from '../../utils/date';

const title = `German IPTV Ratgeber & Guides ${currentYear} — Technik, Recht & Tests`;
const description = `Umfassende Ratgeber rund um IPTV in Deutschland ${currentYear}: Rechtliche Lage (UrhG & EuGH), Bundesliga Streaming, Anleitungen für Fire TV & App Testsieger.`;
const canonical = "https://germaniptv.cloud/guides/";

const keywords = [
  "iptv ratgeber",
  `iptv ratgeber ${currentYear}`,
  "iptv anleitung",
  "iptv legal deutschland",
  "beste iptv app",
  "bundesliga iptv guide",
  "iptv einrichten",
  "iptv abmahnung"
];

const allGuides = await getCollection('guides');
const sortedGuides = allGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={title} description={description} canonicalURL={canonical} keywords={keywords} image="/images/pages/iptv-guides-hub.webp">
  <StickyHeader />

  <!-- Breadcrumb Bar -->
  <div class="bg-[#12141D] border-b border-white/5 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 text-xs text-gray-400">
      <a href="/" class="hover:text-white transition-colors">Startseite</a>
      <ChevronRight class="w-3.5 h-3.5" />
      <span class="text-white font-medium">Ratgeber & Guides</span>
    </div>
  </div>

  <!-- Header -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-[#12141D] to-[#0B0C10] border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.05] border border-white/10 text-gray-300 text-xs font-semibold uppercase tracking-wider mb-6">
        <BookOpen class="w-4 h-4 text-[#DC2626]" />
        <span>Expertenwissen & Marktanalysen</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight max-w-3xl mx-auto mb-6">
        IPTV Ratgeber, Tests & <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#F59E0B]">Rechtliche Einordnung</span>
      </h1>

      <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
        Fundierte Artikel unserer Technik- und Rechtsexperten zu legalem Streaming, Abmahnungen, Bundesliga ohne teure Abos und Schritt-für-Schritt-Anleitungen.
      </p>
    </div>
  </section>

  <!-- Guides Grid -->
  <section class="py-16 bg-[#0B0C10]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {sortedGuides.length === 0 ? (
        <div class="text-center py-12 text-gray-400">
          <p>Aktuell werden neue Artikel vorbereitet. Bitte schaue in Kürze wieder vorbei.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedGuides.map((guide) => (
            <article class="flex flex-col bg-[#12141D] border border-white/10 rounded-2xl overflow-hidden hover:border-[#DC2626]/40 transition-all group shadow-xl">
              <a href={`/guides/${guide.slug}/`} class="block overflow-hidden aspect-[16/9] bg-white/5 relative">
                <img 
                  src={guide.data.image} 
                  alt={injectCurrentYear(guide.data.imageAlt)} 
                  width="600" 
                  height="338" 
                  loading="lazy" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </a>
              <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 text-xs text-gray-400 mb-4">
                    <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 font-semibold text-[#F59E0B]">
                      {guide.data.category}
                    </span>
                    <span class="flex items-center gap-1 text-gray-400">
                      <Clock class="w-3.5 h-3.5" />
                      {guide.data.readingTime}
                    </span>
                  </div>

                  <h2 class="text-xl font-bold text-white group-hover:text-red-400 transition-colors mb-3 leading-snug">
                    <a href={`/guides/${guide.slug}/`}>
                      {injectCurrentYear(guide.data.title)}
                    </a>
                  </h2>

                  <p class="text-sm text-gray-300 line-clamp-3 mb-6 leading-relaxed">
                    {injectCurrentYear(guide.data.description)}
                  </p>
                </div>

                <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs text-gray-400">
                  <div class="flex items-center gap-2">
                    <User class="w-3.5 h-3.5 text-gray-400" />
                    <span>{guide.data.author}</span>
                  </div>
                  <a href={`/guides/${guide.slug}/`} class="inline-flex items-center gap-1 font-semibold text-[#DC2626] group-hover:translate-x-1 transition-transform">
                    <span>Lesen</span>
                    <ChevronRight class="w-3.5 h-3.5" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Footer -->
  <Footer />

  <FloatingWhatsApp />
  <ExitPopup />
</Layout>
