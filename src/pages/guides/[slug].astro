<!-- Client-side Interactive Reading Progress & Active TOC Spy -->
<script is:inline>
  // Top Viewport Reading Progress Bar
  const progressBar = document.getElementById('reading-progress-bar');
  function updateProgress() {
    if (!progressBar) return;
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    if (docHeight <= 0) return;
    const progress = Math.min(100, Math.max(0, (scrollTop / docHeight) * 100));
    progressBar.style.width = progress + '%';
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);

  // Copy Link with Feedback
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-text');
  const copyIcon = document.getElementById('copy-icon');

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyText) copyText.textContent = 'Kopiert!';
        if (copyBtn) copyBtn.classList.add('text-[#10B981]', 'border-[#10B981]/40');
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Link kopieren';
          if (copyBtn) copyBtn.classList.remove('text-[#10B981]', 'border-[#10B981]/40');
        }, 2000);
      } catch (err) {
        // Fallback
      }
    });
  }

  // Active TOC Heading Spy
  const tocLinks = document.querySelectorAll('.toc-link');
  const articleHeadings = document.querySelectorAll('.prose-editorial h2, .prose-editorial h3');

  function updateActiveHeading() {
    if (articleHeadings.length === 0 || tocLinks.length === 0) return;

    let currentActiveId = '';
    const scrollPos = window.scrollY + 140;

    articleHeadings.forEach((heading) => {
      const top = heading.getBoundingClientRect().top + window.scrollY;
      if (scrollPos >= top) {
        currentActiveId = heading.getAttribute('id') || '';
      }
    });

    tocLinks.forEach((link) => {
      const targetId = link.getAttribute('data-heading-id');
      if (targetId && targetId === currentActiveId) {
        link.classList.add('bg-[#DC2626]/15', 'text-white', 'border-l-2', 'border-[#DC2626]');
        link.classList.remove('text-gray-400', 'text-gray-300');
      } else {
        link.classList.remove('bg-[#DC2626]/15', 'text-white', 'border-l-2', 'border-[#DC2626]');
      }
    });
  }

  window.addEventListener('scroll', updateActiveHeading, { passive: true });

  // Dynamic Year synchronizer for editorial article body text
  try {
    const currentYearVal = new Date().getFullYear().toString();
    const proseBody = document.querySelector('.prose-editorial');
    if (proseBody) {
      const textWalker = document.createTreeWalker(proseBody, NodeFilter.SHOW_TEXT, null);
      let currentNode;
      while ((currentNode = textWalker.nextNode())) {
        if (currentNode.nodeValue && /\b202[4-9]\b|\b203[0-5]\b/.test(currentNode.nodeValue)) {
          currentNode.nodeValue = currentNode.nodeValue.replace(/\b202[4-9]\b|\b203[0-5]\b/g, currentYearVal);
        }
      }
    }
  } catch (e) {
    // Graceful fallback
  }
</script>

