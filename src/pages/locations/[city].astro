      state: 'Nordrhein-Westfalen',
      clubs: '1. FC Köln & Fortuna Köln',
      isp: 'NetCologne, Telekom & Vodafone',
      latency: '10ms',
      population: '1.080.000'
    },
    {
      slug: 'frankfurt',
      name: 'Frankfurt am Main',
      state: 'Hessen',
      clubs: 'Eintracht Frankfurt & FSV Frankfurt',
      isp: 'DE-CIX Direktanbindung, Telekom & Vodafone',
      latency: '4ms',
      population: '760.000'
    },
    {
      slug: 'stuttgart',
      name: 'Stuttgart',
      state: 'Baden-Württemberg',
      clubs: 'VfB Stuttgart & Stuttgarter Kickers',
      isp: 'Telekom, Vodafone & NetCom BW',
      latency: '8ms',
      population: '630.000'
    },
    {
      slug: 'duesseldorf',
      name: 'Düsseldorf',
      state: 'Nordrhein-Westfalen',
      clubs: 'Fortuna Düsseldorf',
      isp: 'Vodafone, Telekom Glasfaser & 1&1',
      latency: '10ms',
      population: '620.000'
    },
    {
      slug: 'leipzig',
      name: 'Leipzig',
      state: 'Sachsen',
      clubs: 'RB Leipzig & Chemie Leipzig',
      isp: 'Telekom Glasfaser & Vodafone',
      latency: '13ms',
      population: '600.000'
    },
    {
      slug: 'dortmund',
      name: 'Dortmund',
      state: 'Nordrhein-Westfalen',
      clubs: 'Borussia Dortmund (BVB)',
      isp: 'DOKOM21, Vodafone & Telekom',
      latency: '11ms',
      population: '590.000'
    },
    {
      slug: 'essen',
      name: 'Essen',
      state: 'Nordrhein-Westfalen',
      clubs: 'Rot-Weiss Essen',
      isp: 'Vodafone & Telekom Glasfaser',
      latency: '11ms',
      population: '580.000'
    },
    {
      slug: 'bremen',
      name: 'Bremen',
