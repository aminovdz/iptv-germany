    },
    {
      slug: 'muenchen',
      name: 'München',
      state: 'Bayern',
      clubs: 'FC Bayern München & TSV 1860 München',
      isp: 'M-net, Telekom Glasfaser & Vodafone',
      latency: '9ms',
      population: '1.500.000'
    },
    {
      slug: 'hamburg',
      name: 'Hamburg',
      state: 'Hamburg',
      clubs: 'Hamburger SV & FC St. Pauli',
      isp: 'willy.tel, wilhelm.tel & Vodafone',
      latency: '12ms',
      population: '1.900.000'
    },
    {
      slug: 'koeln',
