---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { currentYear } from '../utils/date';

const title = `Kontakt & Kundenservice 24/7 (${currentYear}) — German IPTV`;
const description = `Kontaktieren Sie den Kundenservice von German IPTV ${currentYear}: Persönlicher deutscher WhatsApp Support, Telegram & E-Mail mit 2-Minuten-Reaktionszeit.`;

const keywords = [
  "german iptv kontakt",
  "iptv kontakt",
  "iptv kundenservice",
  "iptv support deutschland",
  "iptv whatsapp support",
  "iptv hilfe"
];
---

<Layout title={title} description={description} keywords={keywords} image="/images/pages/iptv-kontakt.webp">
  <StickyHeader currentPath="/contact" />

  <main>
    <div class="max-w-4xl mx-auto pt-10 px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#12141D]">
        <img
          src="/images/pages/iptv-kontakt.webp"
          alt="German IPTV 24/7 Kundenservice via WhatsApp und E-Mail mit 2-Minuten-Reaktionszeit"
          width="1200"
          height="630"
          class="w-full h-auto object-cover max-h-[400px]"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
    <ContactForm />
    <FAQSection />
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
