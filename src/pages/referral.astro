---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { Gift, Users, Share2, Award, MessageCircle } from 'lucide-astro';
import { currentYear } from '../utils/date';

const title = `Freunde Werben & Gratis-Monate Sichern (${currentYear}) — German IPTV`;
const description = `Empfehle German IPTV ${currentYear} weiter: Für jeden vermittelten Freund erhältst du 1 Gratismonat zu deinem bestehenden 4K Streaming Abo!`;

const keywords = [
  "german iptv freunde werben",
  "iptv freunde werben",
  `iptv freunde werben ${currentYear}`,
  "iptv gratismonat",
  "iptv empfehlungsprogramm",
  "german iptv bonus",
  "iptv kostenlos monat",
  "iptv vorteile"
];

const referralText = encodeURIComponent("Schau dir German IPTV an — echtes 4K Streaming ohne Buffering mit Bundesliga und Champions League: https://germaniptv.cloud");
const shareUrl = `https://api.whatsapp.com/send?text=${referralText}`;
---

<Layout title={title} description={description} keywords={keywords} image="/images/pages/iptv-referral.webp">
  <StickyHeader currentPath="/referral" />

  <main class="py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Banner -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-bold uppercase tracking-wider mb-4">
        <Gift class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>Exklusives Belohnungsprogramm</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Freunde werben und <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#F59E0B]">kostenlos streamen</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed mb-8">
        Sind Sie zufrieden mit unserer Bildqualität und Stabilität? Teilen Sie Ihre Begeisterung: Für jede vermittelte Person erhalten Sie 1 Gratismonat zu Ihrem laufenden Abonnement gutgeschrieben!
      </p>

      <!-- Visual Referral Banner with Alt -->
      <div class="max-w-3xl mx-auto rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#12141D]">
        <img
          src="/images/pages/iptv-referral.webp"
          alt="German IPTV Freunde werben und Partnerprogramm: Gratismonate und Streaming-Prämien sichern"
          width="1200"
          height="630"
          class="w-full h-auto object-cover max-h-[400px]"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

    <!-- 3 Simple Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="p-8 rounded-3xl bg-[#12141D] border border-white/[0.08] text-center space-y-4">
        <div class="w-14 h-14 rounded-2xl bg-[#DC2626]/15 border border-[#DC2626]/30 flex items-center justify-center text-[#DC2626] mx-auto">
          <Share2 class="w-7 h-7" />
        </div>
        <h2 class="text-lg font-bold text-white">1. Link weiterleiten</h2>
        <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
          Senden Sie Ihren Empfehlungslink oder unsere Kontaktdaten per WhatsApp an Freunde, Verwandte oder Kollegen.
        </p>
      </div>

      <div class="p-8 rounded-3xl bg-[#12141D] border border-white/[0.08] text-center space-y-4">
        <div class="w-14 h-14 rounded-2xl bg-[#F59E0B]/15 border border-[#F59E0B]/30 flex items-center justify-center text-[#F59E0B] mx-auto">
          <Users class="w-7 h-7" />
        </div>
        <h2 class="text-lg font-bold text-white">2. Freund schließt Abo ab</h2>
        <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
          Ihr Freund bucht ein beliebiges Paket (1, 3, 6 oder 12 Monate) und nennt bei der Bestellung einfach Ihren Namen oder Ihre E-Mail.
        </p>
      </div>

      <div class="p-8 rounded-3xl bg-[#12141D] border border-white/[0.08] text-center space-y-4">
        <div class="w-14 h-14 rounded-2xl bg-[#10B981]/15 border border-[#10B981]/30 flex items-center justify-center text-[#10B981] mx-auto">
          <Award class="w-7 h-7" />
        </div>
        <h2 class="text-lg font-bold text-white">3. +1 Gratismonat sichern</h2>
        <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
          Wir verlängern Ihr aktives IPTV-Abonnement sofort um volle 30 Tage – ohne Begrenzung für beliebig viele Freunde!
        </p>
      </div>
    </div>

    <!-- Direct Share CTA Box -->
    <div class="rounded-3xl bg-gradient-to-r from-[#181926] via-[#14121A] to-[#181926] border border-[#DC2626]/40 p-8 sm:p-12 text-center shadow-2xl mb-16">
      <h2 class="text-2xl sm:text-3xl font-black text-white mb-4">
        Jetzt sofort per WhatsApp einladen
      </h2>
      <p class="text-sm text-gray-300 max-w-xl mx-auto mb-8">
        Klicken Sie auf den Button, um den vorbereiteten Einladungstext mit einem Klick an Ihre WhatsApp-Kontakte zu versenden:
      </p>

      <a
        href={shareUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#10B981] to-[#059669] text-black font-extrabold text-sm uppercase tracking-wider shadow-lg hover:scale-105 transition-all"
      >
        <MessageCircle class="w-5 h-5 fill-current" />
        <span>Auf WhatsApp Teilen</span>
      </a>
    </div>

  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
