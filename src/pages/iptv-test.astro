---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ExitPopup from '../components/ExitPopup.astro';
import PricingCard from '../components/PricingCard.astro';
import { 
  Tv, Zap, ShieldCheck, CheckCircle2, MessageCircle, Clock, 
  HelpCircle, ArrowRight, Sparkles, Send, Smartphone, Monitor, Check
} from 'lucide-astro';
import { currentYear } from '../utils/date';

const title = `IPTV Testline Kostenlos (24h Test) — German IPTV Sofort Testen (${currentYear})`;
const description = `Jetzt IPTV kostenlos testen: 24 Stunden unverbindliche IPTV Testline in 4K/8K. Alle deutschen Sender, Bundesliga, DAZN, Formel 1 ohne Kreditkarte oder Abo.`;
const canonical = "https://germaniptv.cloud/iptv-test/";

const keywords = [
  "iptv test",
  "iptv testline",
  "testline iptv",
  "iptv kostenlos testen",
  "iptv 24h test",
  "iptv free trial",
  "iptv line test",
  "iptv gratis test",
  "iptv premium test",
  `iptv test ${currentYear}`,
  "iptv testline deutschland",
  "iptv probeabo",
  "iptv m3u testline"
];

const whatsappUrl = "https://wa.me/213550592200?text=Hallo!%20Ich%20m%C3%B6chte%20gerne%20die%20kostenlose%2024-Stunden%20IPTV%20Testline%20f%C3%BCr%20German%20IPTV%20anfordern.";

const faqTestItems = [
  {
    q: "Wie lange ist die IPTV Testline gültig?",
    a: "Die Testline ist ab dem Zeitpunkt der Bereitstellung genau 24 Stunden lang aktiv. Du kannst in dieser Zeit alle 24.000+ Sender, Video-on-Demand (Filme & Serien) sowie alle Live-Sport-Events in voller 4K/8K-Qualität uneingeschränkt testen."
  },
  {
    q: "Kostet der 24h IPTV Test wirklich nichts?",
    a: "Ja, der 24-Stunden-Test ist zu 100 % kostenlos und unverbindlich. Wir verlangen weder Kreditkartendaten noch gehst du ein Abonnement ein. Die Testline läuft nach 24 Stunden automatisch aus – kein Kündigungsaufwand."
  },
  {
    q: "Welche Daten erhalte ich für den Test?",
    a: "Du erhältst standardmäßig sowohl eine M3U-Playlist-URL (für Apps wie TiviMate, VLC, Smart IPTV) als auch Xtream Codes Zugangsdaten (Server URL, Benutzername, Passwort) für Android, Fire TV Stick, Apple TV oder Smart TVs."
  },
  {
    q: "Auf welchen Geräten kann ich die Testline nutzen?",
    a: "Auf allen gängigen Geräten: Amazon Fire TV Stick, Samsung & LG Smart TV, Android Smartphones/Tablets, Windows PC, Mac, Apple TV sowie Enigma2/MAG-Receivern."
  },
  {
    q: "Wie schnell erhalte ich meinen Testzugang?",
    a: "Über unseren WhatsApp-Support erfolgt die Bereitstellung in der Regel innerhalb von 5 bis 15 Minuten. Bei Kontakt per Formular senden wir dir die Zugangsdaten direkt per E-Mail."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `German IPTV 24h Kostenlose Testline (${currentYear})`,
  "image": "https://germaniptv.cloud/images/pages/iptv-test.webp",
  "description": "Kostenloser 24-Stunden-Testzugang für German IPTV mit über 24.000 Sendern, Bundesliga, Champions League in 4K/FHD mit Anti-Freeze 9.8™.",
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "priceValidUntil": `${currentYear}-12-31`
  }
};
---

<Layout title={title} description={description} keywords={keywords} canonicalURL={canonical} schema={schemaData}>
  <StickyHeader currentPath="/iptv-test/" />

  <!-- Breadcrumb -->
  <nav class="bg-[#0B0C10] border-b border-white/[0.06] py-2.5 px-4 sm:px-6 lg:px-8 text-xs text-gray-400" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-white transition-colors">Startseite</a>
      <span>/</span>
      <span class="text-[#DC2626] font-semibold">IPTV Test & Testline</span>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-gradient-to-b from-[#0F111A] via-[#0B0C10] to-[#07080D]">
    <div class="absolute inset-0 pointer-events-none -z-10">
      <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#DC2626]/15 rounded-full blur-[140px]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#1A1D2B] border border-[#DC2626]/30 text-amber-300 text-xs font-semibold mb-6 shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-[#DC2626]" />
        <span>100 % Kostenlos &bull; Keine Kreditkarte &bull; Keine automatische Verlängerung</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        IPTV Testline Kostenlos anfordern: <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#F59E0B]">
          24 Stunden Premium IPTV Test
        </span>
      </h1>

      <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto mb-8 leading-relaxed">
        Überzeuge dich selbst von unserer Übertragungsqualität: Teste über <strong>24.000 deutsche und internationale TV-Sender</strong>, 
        Live-Fußball (Bundesliga, Champions League, DAZN) in <strong>4K & FHD</strong> sowie über 50.000 Filme & Serien völlig risikofrei.
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 text-xs text-gray-300 mb-10">
        <span class="flex items-center gap-1.5 bg-[#12141D] border border-white/10 px-3 py-1.5 rounded-lg">
          <Clock class="w-4 h-4 text-[#F59E0B]" /> Aktivierung in unter 15 Min.
        </span>
        <span class="flex items-center gap-1.5 bg-[#12141D] border border-white/10 px-3 py-1.5 rounded-lg">
          <ShieldCheck class="w-4 h-4 text-emerald-400" /> Anti-Freeze 9.8™ 60 FPS
        </span>
        <span class="flex items-center gap-1.5 bg-[#12141D] border border-white/10 px-3 py-1.5 rounded-lg">
          <Zap class="w-4 h-4 text-amber-400" /> M3U & Xtream Codes
        </span>
      </div>

      <!-- Action Box: WhatsApp Direct or Form -->
      <div class="max-w-xl mx-auto bg-[#12141D]/90 border border-[#DC2626]/40 rounded-2xl p-6 sm:p-8 shadow-[0_0_35px_rgba(220,38,38,0.2)]">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Express-Testline per WhatsApp starten</h2>
        <p class="text-xs sm:text-sm text-gray-400 mb-6">
          Der schnellste Weg zu deinen Zugangsdaten. Schreibe unserem Support kurz dein Gerät (z.B. Fire TV Stick, Samsung TV, TiviMate), und wir senden dir die Testline sofort zu.
        </p>

        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-3 px-6 py-4 rounded-xl text-base font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-lg shadow-emerald-900/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
        >
          <MessageCircle class="w-5 h-5 text-white" />
          <span>Jetzt 24h Testline per WhatsApp anfordern</span>
        </a>

        <div class="mt-4 flex items-center justify-center gap-2 text-[11px] text-gray-400">
          <Check class="w-3.5 h-3.5 text-emerald-400" /> 24h WhatsApp-Support &bull; Sofortige Freischaltung
        </div>
      </div>
    </div>
  </section>

  <!-- Value Matrix / Why Test -->
  <section class="py-16 bg-[#0B0C10] border-t border-b border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">
          Was ist in der kostenlosen IPTV Testline enthalten?
        </h2>
        <p class="text-gray-400 text-sm sm:text-base">
          Unsere Testline entspricht zu 100 % dem Funktionsumfang unserer regulären Premium-Abonnements. Kein kastrierter Zugang!
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-[#12141D] border border-white/[0.08] rounded-xl p-6 hover:border-[#DC2626]/50 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-[#DC2626]/10 border border-[#DC2626]/20 flex items-center justify-center mb-4 text-[#DC2626]">
            <Tv class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Alle Sender & Sport in 4K</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Über 24.000 TV-Kanäle aus Deutschland, Österreich, der Schweiz sowie ganz Europa. Inklusive Sky Sport, DAZN, Bundesliga & Champions League.
          </p>
        </div>

        <div class="bg-[#12141D] border border-white/[0.08] rounded-xl p-6 hover:border-[#DC2626]/50 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-4 text-[#F59E0B]">
            <ShieldCheck class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Anti-Freeze 9.8™ Pufferfrei</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Teste unsere CDN-gestützten Server während Live-Spitzenspielen. Keine Ruckler, kein Pixelmatsch – flüssiges Streaming bei 60 Bildern pro Sekunde.
          </p>
        </div>

        <div class="bg-[#12141D] border border-white/[0.08] rounded-xl p-6 hover:border-[#DC2626]/50 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-4 text-emerald-400">
            <Smartphone class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Volle Gerätekompatibilität</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Funktioniert mit allen gängigen Apps: TiviMate, IPTV Smarters Pro, Smart One IPTV, IBO Player, Net IPTV, SS IPTV und Kodi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Step Installation Flow -->
  <section class="py-16 bg-[#0E1017]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#DC2626] mb-2 block">Schritt für Schritt</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">So einfach startest du deinen 24h IPTV Test</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <div class="flex flex-col items-center text-center p-6 bg-[#12141D] border border-white/5 rounded-xl">
          <div class="w-12 h-12 rounded-full bg-[#DC2626] text-white flex items-center justify-center font-black text-lg mb-4 shadow-lg shadow-red-900/40">
            1
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Testline anfordern</h3>
          <p class="text-sm text-gray-400">
            Schreib uns kurz über WhatsApp oder per Mail und nenne uns dein Gerät (z.B. Fire TV Stick oder Smart TV).
          </p>
        </div>

        <div class="flex flex-col items-center text-center p-6 bg-[#12141D] border border-white/5 rounded-xl">
          <div class="w-12 h-12 rounded-full bg-[#DC2626] text-white flex items-center justify-center font-black text-lg mb-4 shadow-lg shadow-red-900/40">
            2
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Daten in App eintragen</h3>
          <p class="text-sm text-gray-400">
            Trage die M3U-Playlist oder Xtream Codes Zugangsdaten in deine bevorzugte Player-App ein.
          </p>
        </div>

        <div class="flex flex-col items-center text-center p-6 bg-[#12141D] border border-white/5 rounded-xl">
          <div class="w-12 h-12 rounded-full bg-[#DC2626] text-white flex items-center justify-center font-black text-lg mb-4 shadow-lg shadow-red-900/40">
            3
          </div>
          <h3 class="text-lg font-bold text-white mb-2">24 Stunden Genießen</h3>
          <p class="text-sm text-gray-400">
            Sofort losschauen in brillantem 4K/8K. Bei Gefallen wählst du später ein reguläres Paket – ohne Unterbrechung!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section for Testline -->
  <section class="py-16 bg-[#0B0C10] border-t border-white/[0.06]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">Häufig gestellte Fragen zum IPTV Test</h2>
        <p class="text-gray-400 text-sm">Alles, was du vor deiner 24h Testline wissen musst.</p>
      </div>

      <div class="space-y-4">
        {faqTestItems.map((item, idx) => (
          <details class="group bg-[#12141D] border border-white/[0.08] rounded-xl p-5 open:border-[#DC2626]/40 transition-all">
            <summary class="flex justify-between items-center font-bold text-white text-base cursor-pointer list-none">
              <span>{item.q}</span>
              <span class="text-[#DC2626] transition-transform duration-200 group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-sm text-gray-300 leading-relaxed border-t border-white/5 pt-3">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-gradient-to-r from-[#DC2626]/20 via-[#12141D] to-[#DC2626]/20 border-t border-b border-[#DC2626]/30 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-4xl font-black text-white mb-4">Bereit für den kostenlosen 24h IPTV Test?</h2>
      <p class="text-gray-300 text-sm sm:text-base max-w-2xl mx-auto mb-8">
        Kein Risiko, keine versteckten Kosten. Starte jetzt deinen Test und erlebe Premium TV in Deutschland wie nie zuvor.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-xl transition-all"
        >
          <MessageCircle class="w-5 h-5" /> 24h Test per WhatsApp starten
        </a>
        <a 
          href="/iptv-kaufen/"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-bold text-white bg-[#1A1D2B] hover:bg-[#25293d] border border-white/10 transition-all"
        >
          Alle Abo-Preise ansehen <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <Footer />
  <FloatingWhatsApp />
  <ExitPopup />
</Layout>
