  <!-- FAQ Section (English) -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-4xl font-black text-white text-center mb-10">
        Frequently Asked Questions
      </h2>

      <div class="space-y-4">
        <div class="bg-[#12141D] border border-white/10 rounded-2xl p-6">
          <h3 class="text-base font-bold text-white mb-2">Can I watch Premier League & Champions League in English?</h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Yes, our subscription includes Sky Sports UK, TNT Sports, and US channels broadcasting with original English audio, alongside German Sky Sport and DAZN feeds.
          </p>
        </div>

        <div class="bg-[#12141D] border border-white/10 rounded-2xl p-6">
          <h3 class="text-base font-bold text-white mb-2">How fast do I receive my credentials?</h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Your login details (M3U playlist link and Xtream Codes API username/password) are sent directly via WhatsApp or email within 3 minutes after payment confirmation.
          </p>
        </div>

        <div class="bg-[#12141D] border border-white/10 rounded-2xl p-6">
          <h3 class="text-base font-bold text-white mb-2">Do I need a VPN to use German IPTV in Germany?</h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            No VPN is required because our streaming connections are secured with 256-bit SSL encryption. However, our servers are 100% VPN-compatible if you prefer extra privacy.
          </p>
        </div>

        <div class="bg-[#12141D] border border-white/10 rounded-2xl p-6">
          <h3 class="text-base font-bold text-white mb-2">Can I test before paying?</h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Absolutely! Contact our English support team on WhatsApp anytime to receive an instant, free 24-hour test account with zero obligations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <FloatingWhatsApp />
  <ExitPopup />
</Layout>
