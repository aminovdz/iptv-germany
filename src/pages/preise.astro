---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ExitPopup from '../components/ExitPopup.astro';
import { Tag, ShieldCheck, CheckCircle2, Lock } from 'lucide-astro';
import { currentYear } from '../utils/date';

const title = `German IPTV Preise & Tarife ${currentYear} — Günstig ab 8 € ohne Vertrag`;
const description = `Transparente IPTV Preise für Deutschland ${currentYear}: Ab 8 €/Monat oder 55 €/Jahr inkl. 4K Player. Ohne Mindestvertragslaufzeit, monatlich kündbar, PayPal & 24h Test.`;
const canonical = "https://germaniptv.cloud/preise/";

const keywords = [
  "iptv preise",
  `iptv preise ${currentYear}`,
  "iptv kosten deutschland",
  "iptv tarife",
  "iptv abonnement preise",
  "iptv 12 monate 55 euro",
  "günstig iptv kaufen",
  "iptv monatlich kündbar",
  "iptv ohne vertrag",
  "iptv preise vergleich"
];
---

<Layout title={title} description={description} canonicalURL={canonical} keywords={keywords} image="/images/pages/iptv-preise.webp">
  <StickyHeader />

  <!-- Page Header -->
  <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 overflow-hidden border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#12141D] border border-[#DC2626]/30 text-red-300 text-xs font-semibold uppercase tracking-wider mb-6">
        <Tag class="w-4 h-4 text-[#DC2626]" />
        <span>Transparente Festpreise ohne versteckte Kosten</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight max-w-4xl mx-auto mb-6">
        IPTV Preise & Abonnements — <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#F59E0B]">Maximale Flexibilität</span>
      </h1>

      <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto mb-6 leading-relaxed">
        Keine automatische Verlängerung, kein Knebelvertrag, monatlich kündbar. Wähle die Laufzeit, die am besten zu dir passt.
      </p>

      <!-- Key Guarantees -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs sm:text-sm text-gray-300 mb-10">
        <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-lg">
          <ShieldCheck class="w-4 h-4 text-emerald-400" />
          <span>24-Stunden Geld-zurück-Garantie</span>
        </div>
        <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-lg">
          <Lock class="w-4 h-4 text-blue-400" />
          <span>PayPal Käuferschutz</span>
        </div>
        <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-lg">
          <CheckCircle2 class="w-4 h-4 text-purple-400" />
          <span>100% Einmalzahlung — kein automatischer Einzug</span>
        </div>
      </div>

      <!-- Visual Pricing Banner with Alt -->
      <div class="max-w-4xl mx-auto rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#12141D]">
        <img
          src="/images/pages/iptv-preise.webp"
          alt={`German IPTV Tarife und Preise ${currentYear} — Transparente Angebote ab 8 Euro monatlich oder 55 Euro Jahresabo`}
          width="1200"
          height="630"
          class="w-full h-auto object-cover max-h-[440px]"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Pricing Cards Component -->
  <PricingCard />

  <!-- Feature Comparison Matrix Across Tiers -->
  <section class="py-16 bg-[#0B0C10] border-t border-white/5">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-white text-center mb-8">
        Was ist in allen Paketen enthalten?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
          <div>
            <strong class="text-white block mb-0.5">Alle deutschen TV-Sender</strong>
            <span class="text-gray-400 text-xs">Alle öffentlich-rechtlichen Vollprogramme, private Hauptsender und regionale Kulturkanäle in Full HD und 4K.</span>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
          <div>
            <strong class="text-white block mb-0.5">Komplettes Live-Sportpaket</strong>
            <span class="text-gray-400 text-xs">Bundesliga, 2. Bundesliga, DFB-Pokal, Champions League, Formel 1 und Darts live.</span>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
          <div>
            <strong class="text-white block mb-0.5">DACH-Region inklusive</strong>
            <span class="text-gray-400 text-xs">Alle österreichischen und Schweizer Vollprogramme & Sportkanäle ohne Geoblocking empfangen.</span>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
          <div>
            <strong class="text-white block mb-0.5">Anti-Freeze 9.8™ Technologie</strong>
            <span class="text-gray-400 text-xs">Intelligentes Load-Balancing und europäische Hochleistungsserver für 0% Pufferung.</span>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
          <div>
            <strong class="text-white block mb-0.5">Elektronischer Programmführer (EPG)</strong>
            <span class="text-gray-400 text-xs">Präzise 7-Tage-Programmvorschau für alle deutschen und internationalen Sender.</span>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/[0.02] border border-white/5">
          <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
          <div>
            <strong class="text-white block mb-0.5">Deutscher 24/7 WhatsApp Support</strong>
            <span class="text-gray-400 text-xs">Persönliche Hilfestellung bei der Einrichtung auf Fire TV, Smart TV, Apple TV oder Smartphone.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSection />

  <!-- Footer -->
  <Footer />

  <FloatingWhatsApp />
  <ExitPopup />
</Layout>
