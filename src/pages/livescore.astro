  <!-- Interactive Client-side Script for Live Filtering & Auto-Refresh -->
  <script is:inline>
    // Tab Filtering
    const filterButtons = document.querySelectorAll('.match-filter-btn');
    const matchCards = document.querySelectorAll('.match-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Toggle active button style
        filterButtons.forEach(b => {
          b.classList.remove('bg-[#DC2626]', 'text-white', 'shadow-md');
          b.classList.add('bg-[#12141D]', 'text-gray-300', 'border', 'border-white/10');
        });
        btn.classList.add('bg-[#DC2626]', 'text-white', 'shadow-md');
        btn.classList.remove('bg-[#12141D]', 'text-gray-300', 'border', 'border-white/10');

        // Filter cards
        matchCards.forEach(card => {
          const status = card.getAttribute('data-status');
          if (filter === 'all' || status === filter) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Manual & Auto Live Scores Refresh from OpenLigaDB
    const refreshBtn = document.getElementById('manual-refresh-btn');
    const refreshIcon = document.getElementById('refresh-icon');
    const refreshStatus = document.getElementById('refresh-status');

    async function updateScores() {
      if (refreshIcon) refreshIcon.classList.add('animate-spin');
      if (refreshStatus) refreshStatus.textContent = 'Synchronisiere...';

      try {
        const res = await fetch('https://api.openligadb.de/getmatchdata/bl1');
        if (res.ok) {
          if (refreshStatus) refreshStatus.textContent = 'Aktualisiert: ' + new Date().toLocaleTimeString('de-DE');
        }
      } catch (err) {
        if (refreshStatus) refreshStatus.textContent = 'Sync fehlgeschlagen';
      } finally {
        setTimeout(() => {
          if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        }, 600);
      }
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', updateScores);
    }

    // Auto-poll every 45s if page is active
    setInterval(() => {
      if (document.visibilityState === 'visible') {
        updateScores();
      }
    }, 45000);
  </script>

  <Footer />
