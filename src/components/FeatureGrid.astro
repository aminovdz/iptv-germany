---
import { Zap, Tv, Clock, Headphones, Wifi, Film, Sparkles, Lock, Smartphone } from 'lucide-astro';

const features = [
  {
    icon: Zap,
    title: "Anti-Freeze 9.8™ Server-Cluster",
    description: "Dedizierte Hochgeschwindigkeits-Server in europäischen Rechenzentren verhindern Pufferung und Bildverzögerungen – selbst bei Top-Spielen der Bundesliga mit Spitzenlast.",
    badge: "99.9% Stabilität",
    color: "crimson"
  },
  {
    icon: Tv,
    title: "4K & 8K Ultra HD bei 60 FPS",
    description: "Erleben Sie Filme, Serien und Sportereignisse in brillanter Bildschärfe mit 60 Bildern pro Sekunde, lebendigen Farben und Unterstützung für Dolby Digital Sound.",
    badge: "Native 60 FPS",
    color: "gold"
  },
  {
    icon: Wifi,
    title: "Keine ISP-Drosselung",
    description: "Intelligentes Routing umgeht Bandbreiten-Drosselungen (Traffic Shaping) deutscher Internet-Provider wie Telekom, Vodafone, 1&1 und O2.",
    badge: "100% Bandbreite",
    color: "crimson"
  },
  {
    icon: Clock,
    title: "Aktivierung in unter 2 Minuten",
    description: "Erhalten Sie Ihre M3U-Playlist und Xtream Codes Zugangsdaten sofort nach der Bestellung direkt via WhatsApp oder E-Mail freigeschaltet.",
    badge: "Sofort-Start",
    color: "gold"
  },
  {
    icon: Film,
    title: "EPG TV-Guide & 7-Tage Catch-Up",
    description: "Lückenlose elektronische Programmzeitschrift (EPG) für alle deutschen Kanäle sowie flexible 7-Tage Replay-Funktion für verpasste Sendungen.",
    badge: "7 Tage Archiv",
    color: "crimson"
  },
  {
    icon: Lock,
    title: "DSGVO-konform & 256-Bit Verschlüsselt",
    description: "Voller Schutz Ihrer Privatsphäre nach strengen deutschen Datenschutzrichtlinien. Ihre Streams und Verbindungen bleiben vollständig verschlüsselt und anonym.",
    badge: "100% Sicher",
    color: "gold"
  },
  {
    icon: Smartphone,
    title: "Alle Geräte & Apps Unterstützt",
    description: "Funktioniert nahtlos auf Amazon Fire TV Stick, Samsung & LG Smart TV, Android Box, Apple TV, iPhone, Android Smartphones, Windows PC und MAG Boxen.",
    badge: "Multi-Device",
    color: "crimson"
  },
  {
    icon: Headphones,
    title: "Deutscher 24/7 WhatsApp Support",
    description: "Keine anonymen Chatbots: Unser erfahrenes deutsches Support-Team hilft Ihnen jederzeit per WhatsApp und Telegram bei der schnellen Einrichtung.",
    badge: "Direktkontakt",
    color: "gold"
  }
];
---

<section id="features" class="py-20 md:py-28 relative bg-[#0D0F17] border-y border-white/[0.06]" aria-labelledby="features-heading">
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/2 left-0 -translate-y-1/2 w-96 h-96 bg-[#DC2626]/05 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-1/3 right-0 w-96 h-96 bg-[#F59E0B]/05 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Warum German IPTV wählen?</span>
      </div>

      <h2 id="features-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Modernste Streaming-Technologie für <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#F59E0B]">höchste deutsche Ansprüche</span>
      </h2>

      <p class="text-base sm:text-lg text-gray-400 font-normal leading-relaxed">
        Vergessen Sie überteuerte Kabelverträge und ständige Ruckler. Wir bieten Ihnen die modernste IPTV-Plattform mit Servern direkt am DE-CIX Frankfurt für minimale Latenz und maximale Stabilität.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((item) => {
        const IconComponent = item.icon;
        const isGold = item.color === 'gold';
        return (
          <div class="group relative rounded-2xl bg-[#12141D] border border-white/[0.08] hover:border-[#DC2626]/40 p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(220,38,38,0.12)] flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class={`w-12 h-12 rounded-xl flex items-center justify-center border transition-colors ${
                  isGold 
                    ? 'bg-[#F59E0B]/10 border-[#F59E0B]/30 text-[#F59E0B] group-hover:bg-[#F59E0B]/20' 
                    : 'bg-[#DC2626]/10 border-[#DC2626]/30 text-[#DC2626] group-hover:bg-[#DC2626]/20'
                }`}>
                  <IconComponent class="w-6 h-6" />
                </div>
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider border ${
                  isGold
                    ? 'bg-[#F59E0B]/10 text-[#F59E0B] border-[#F59E0B]/30'
                    : 'bg-[#DC2626]/10 text-[#DC2626] border-[#DC2626]/30'
                }`}>
                  {item.badge}
                </span>
              </div>

              <h3 class="text-lg font-bold text-white mb-3 group-hover:text-amber-100 transition-colors">
                {item.title}
              </h3>

              <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
                {item.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/[0.06] flex items-center gap-1.5 text-xs font-semibold text-gray-400 group-hover:text-white transition-colors">
              <span>Testsieger Standard</span>
              <span class="text-[#10B981]">✓ Verifiziert</span>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
