---
import { MessageCircle, Send, X, Bell, Sparkles } from 'lucide-astro';

const whatsappChannelUrl = "https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v";
const telegramChannelUrl = "https://t.me/castvera_com";
---

<!-- Community Channels Floating Trigger / Modal -->
<div
  id="groups-popup"
  class="fixed bottom-24 right-6 z-40 hidden max-w-sm w-full rounded-3xl bg-[#12141D] border border-[#DC2626]/40 p-5 shadow-[0_15px_40px_rgba(0,0,0,0.7)] backdrop-blur-2xl transition-all duration-300 transform translate-y-10 opacity-0"
  role="region"
  aria-label="Offizielle Community Kanäle German IPTV"
>
  <!-- Close Button -->
  <button
    id="close-groups-popup"
    type="button"
    class="absolute top-3 right-3 p-1.5 rounded-full text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 transition-colors focus:outline-none"
    aria-label="Hinweis schließen"
  >
    <X class="w-4 h-4" />
  </button>

  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 rounded-xl bg-[#DC2626]/20 border border-[#DC2626]/40 flex items-center justify-center text-[#DC2626]">
      <Bell class="w-5 h-5" />
    </div>
    <div>
      <div class="text-[11px] font-bold uppercase tracking-wider text-[#F59E0B] flex items-center gap-1">
        <Sparkles class="w-3 h-3" /> Offizielle DACH Community
      </div>
      <h3 class="text-sm font-bold text-white">Verpassen Sie keine Bundesliga-Spiele!</h3>
    </div>
  </div>

  <p class="text-xs text-gray-300 leading-relaxed mb-4">
    Treten Sie unseren Kanälen bei, um tägliche Spielpläne, Spielstand-Updates, Serverstatus-Meldungen und exklusive Rabattcodes zu erhalten.
  </p>

  <div class="space-y-2">
    <!-- WhatsApp Channel Button -->
    <a
      href={whatsappChannelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-[#10B981] hover:bg-[#059669] text-black text-xs font-black uppercase tracking-wider shadow-md transition-colors"
      aria-label="WhatsApp Kanal abonnieren"
    >
      <MessageCircle class="w-4 h-4" />
      <span>WhatsApp Kanal Abonnieren</span>
    </a>

    <!-- Telegram Channel Button -->
    <a
      href={telegramChannelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-[#2563EB]/20 hover:bg-[#2563EB]/30 text-sky-400 border border-sky-500/30 text-xs font-bold uppercase tracking-wider transition-colors"
      aria-label="Telegram Kanal beitreten"
    >
      <Send class="w-4 h-4" />
      <span>Telegram Kanal Beitreten</span>
    </a>
  </div>
</div>

<script>
  const GROUPS_STORAGE_KEY = 'iptv_de_groups_popup_dismissed_v1';
  const GROUPS_COOLDOWN_MS = 24 * 60 * 60 * 1000; // 24-hour persistence

  const groupsPopup = document.getElementById('groups-popup');
  const closeGroupsBtn = document.getElementById('close-groups-popup');

  function isEligible(): boolean {
    const lastDismissed = localStorage.getItem(GROUPS_STORAGE_KEY);
    if (lastDismissed) {
      const elapsed = Date.now() - parseInt(lastDismissed, 10);
      if (elapsed < GROUPS_COOLDOWN_MS) {
        return false;
      }
    }
    return true;
  }

  function showGroupsPopup() {
    if (!isEligible() || !groupsPopup) return;
    groupsPopup.classList.remove('hidden');
    setTimeout(() => {
      groupsPopup.classList.remove('translate-y-10', 'opacity-0');
      groupsPopup.classList.add('translate-y-0', 'opacity-100');
    }, 20);
  }

  function dismissGroupsPopup() {
    if (!groupsPopup) return;
    groupsPopup.classList.remove('translate-y-0', 'opacity-100');
    groupsPopup.classList.add('translate-y-10', 'opacity-0');
    setTimeout(() => {
      groupsPopup.classList.add('hidden');
    }, 300);
    localStorage.setItem(GROUPS_STORAGE_KEY, Date.now().toString());
  }

  // Show after 16 seconds if eligible
  setTimeout(() => {
    showGroupsPopup();
  }, 16000);

  if (closeGroupsBtn) {
    closeGroupsBtn.addEventListener('click', dismissGroupsPopup);
  }
</script>
