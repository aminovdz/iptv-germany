---
import { Star, CheckCircle2, ShieldCheck, Sparkles, Award } from 'lucide-astro';
import { currentYear } from '../utils/date';

const reviews = [
  {
    author: "Maximilian Weber",
    location: "München",
    date: "Vor 2 Tagen",
    rating: 5,
    plan: "12 Monate Testsieger Paket",
    title: "Endlich Bundesliga & Champions League ohne ständiges Ruckeln!",
    content: "Ich hatte zuvor mehrere teure Pay-TV und Sport-Abos für fast 95 € monatlich abonniert. Bei German IPTV habe ich das 12-Monate-Paket für 55 € geholt und die Qualität auf meinem LG OLED in 4K bei 60 FPS ist einfach atemberaubend. Kein Buffering während der Samstagsspiele!",
    verified: true
  },
  {
    author: "Sarah Lindemann",
    location: "Berlin",
    date: "Vor 4 Tagen",
    rating: 5,
    plan: "12 Monate + Premium Player",
    title: "Aktivierung in 2 Minuten über WhatsApp",
    content: "Nach der Zahlung per PayPal mit Käuferschutz hatte ich meine M3U-Playlist und die Zugangsdaten für TiviMate innerhalb von 2 Minuten auf WhatsApp. Der deutsche Support hat mir sogar kurz bei der Einrichtung geholfen. Absolut erstklassig.",
    verified: true
  },
  {
    author: "Thomas Berger",
    location: "Zürich (Schweiz) / DACH",
    date: "Vor 6 Tagen",
    rating: 5,
    plan: "12 Monate Paket",
    title: "Bester Empfang in der Schweiz",
    content: "Wir schauen in Zürich sowohl deutsche als auch Schweizer und österreichische Sender. Alles läuft kristallklar in HD und 4K. Der 7-Tage EPG Guide funktioniert tadellos.",
    verified: true
  },
  {
    author: "Dennis Krause",
    location: "Hamburg",
    date: "Vor 1 Woche",
    rating: 5,
    plan: "6 Monate Paket",
    title: "Anti-Freeze 9.8™ hält wirklich, was es verspricht",
    content: "Auf meinem Fire TV Stick 4K Max laufen alle Streams flüssig bei 60 Bildern pro Sekunde. Keine Hänger, keine Pixelfehler. Der beste Anbieter, den ich in den letzten Jahren getestet habe.",
    verified: true
  },
  {
    author: "Julia Hoffmann",
    location: "Frankfurt am Main",
    date: "Vor 1 Woche",
    rating: 5,
    plan: "12 Monate Paket",
    title: "Enorme Ersparnis und keine Knebelverträge",
    content: "Keine 24 Monate Vertragsbindung wie bei der Telekom. Wenn das Jahr vorbei ist, entscheide ich selbst. Das gibt mir ein sicheres Gefühl. 5 von 5 Sternen!",
    verified: true
  },
  {
    author: "Markus Schmidt",
    location: "Köln",
    date: "Vor 2 Wochen",
    rating: 5,
    plan: "12 Monate Paket",
    title: "100% Empfehlung für Sportfans",
    content: "Premier League, Formel 1, Bundesliga und DFB-Pokal in voller 4K-Auflösung. Ich habe den Dienst auch meinen Freunden weiterempfohlen und dafür Gratis-Monate erhalten.",
    verified: true
  }
];
---

<section id="reviews" class="py-20 md:py-28 relative bg-[#0D0F17] border-t border-white/[0.06]" aria-labelledby="reviews-heading">
  <!-- Glow Accents -->
  <div class="absolute top-1/3 left-10 w-96 h-96 bg-[#DC2626]/05 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-[#F59E0B]/05 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>Echte Kundenstimmen · DACH Region</span>
      </div>

      <h2 id="reviews-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Was unsere Kunden in <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#F59E0B]">Deutschland sagen</span>
      </h2>

      <p class="text-base sm:text-lg text-gray-400 font-normal leading-relaxed">
        Über 12.000 aktive Abonnenten vertrauen auf unsere unterbrechungsfreie Streaming-Infrastruktur. Lesen Sie verifizierte Erfahrungsberichte.
      </p>

      <!-- Trust Badges Summary Bar -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 p-4 rounded-2xl bg-[#12141D] border border-white/[0.08] max-w-2xl mx-auto text-xs">
        <div class="flex items-center gap-2">
          <div class="flex text-[#F59E0B]">
            {[...Array(5)].map(() => (
              <Star class="w-4 h-4 fill-current" />
            ))}
          </div>
          <span class="font-bold text-white">4.9 / 5.0</span>
          <span class="text-gray-400">(Trustpilot & ProvenExpert)</span>
        </div>
        <div class="h-4 w-px bg-white/10 hidden sm:block"></div>
        <div class="flex items-center gap-1.5 text-[#10B981] font-semibold">
          <ShieldCheck class="w-4 h-4" />
          <span>100% Verifizierte Käufe</span>
        </div>
        <div class="h-4 w-px bg-white/10 hidden sm:block"></div>
        <div class="flex items-center gap-1.5 text-[#F59E0B] font-semibold">
          <Award class="w-4 h-4" />
          <span>Testsieger {currentYear} Note 1.1</span>
        </div>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((rev) => (
        <div class="rounded-2xl bg-[#12141D] border border-white/[0.08] hover:border-[#DC2626]/40 p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl flex flex-col justify-between group">
          <div>
            <!-- Review Top Meta -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1 text-[#F59E0B]">
                {[...Array(rev.rating)].map(() => (
                  <Star class="w-4 h-4 fill-current" />
                ))}
              </div>
              <span class="text-[11px] text-gray-500 font-medium">{rev.date}</span>
            </div>

            <h3 class="text-base font-bold text-white mb-3 group-hover:text-amber-100 transition-colors">
              "{rev.title}"
            </h3>

            <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6 font-normal">
              {rev.content}
            </p>
          </div>

          <!-- Author Box -->
          <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between">
            <div>
              <div class="text-xs font-bold text-white flex items-center gap-1.5">
                <span>{rev.author}</span>
                {rev.verified && (
                  <CheckCircle2 class="w-3.5 h-3.5 text-[#10B981]" />
                )}
              </div>
              <span class="text-[11px] text-gray-400">{rev.location} · <span class="text-gray-300">{rev.plan}</span></span>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded bg-[#10B981]/15 text-[#10B981] font-bold">
              Verifiziert
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
