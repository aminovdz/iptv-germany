---
import { MapPin, ArrowRight, Server } from 'lucide-astro';

const cities = [
  { name: 'Berlin', slug: 'berlin', state: 'Berlin', ping: '< 5ms' },
  { name: 'München', slug: 'muenchen', state: 'Bayern', ping: '< 6ms' },
  { name: 'Hamburg', slug: 'hamburg', state: 'Hamburg', ping: '< 7ms' },
  { name: 'Köln', slug: 'koeln', state: 'Nordrhein-Westfalen', ping: '< 6ms' },
  { name: 'Frankfurt am Main', slug: 'frankfurt', state: 'Hessen (DE-CIX Knoten)', ping: '< 3ms' },
  { name: 'Stuttgart', slug: 'stuttgart', state: 'Baden-Württemberg', ping: '< 7ms' },
  { name: 'Düsseldorf', slug: 'duesseldorf', state: 'Nordrhein-Westfalen', ping: '< 6ms' },
  { name: 'Leipzig', slug: 'leipzig', state: 'Sachsen', ping: '< 7ms' },
  { name: 'Dortmund', slug: 'dortmund', state: 'Nordrhein-Westfalen', ping: '< 6ms' },
  { name: 'Essen', slug: 'essen', state: 'Nordrhein-Westfalen', ping: '< 6ms' },
  { name: 'Bremen', slug: 'bremen', state: 'Bremen', ping: '< 8ms' },
  { name: 'Dresden', slug: 'dresden', state: 'Sachsen', ping: '< 8ms' },
  { name: 'Hannover', slug: 'hannover', state: 'Niedersachsen', ping: '< 7ms' },
  { name: 'Nürnberg', slug: 'nuernberg', state: 'Bayern', ping: '< 6ms' },
  { name: 'Duisburg', slug: 'duisburg', state: 'Nordrhein-Westfalen', ping: '< 6ms' }
];
---

<section id="cities" class="py-20 md:py-28 relative bg-[#0D0F17] border-y border-white/[0.06]" aria-labelledby="cities-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-bold uppercase tracking-wider mb-4">
        <MapPin class="w-3.5 h-3.5 text-[#DC2626]" />
        <span>Lokale Server-Präsenz · Bundesweit</span>
      </div>

      <h2 id="cities-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        IPTV Kaufen in <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#F59E0B]">Ihrer deutschen Region</span>
      </h2>

      <p class="text-base sm:text-lg text-gray-400 font-normal leading-relaxed">
        Dank unserer direkten Anbindung an den weltgrößten Internetknoten DE-CIX in Frankfurt und regionalen Edge-Caching-Servern garantieren wir in allen Bundesländern minimale Ping-Zeiten und stabile Streams.
      </p>
    </div>

    <!-- Cities Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {cities.map((city) => (
        <a
          href={`/locations/${city.slug}/`}
          class="group rounded-2xl bg-[#12141D] border border-white/[0.08] hover:border-[#DC2626]/50 p-5 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg flex items-center justify-between"
          aria-label={`IPTV Kaufen in ${city.name}`}
        >
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-white/[0.04] group-hover:bg-[#DC2626]/20 border border-white/10 group-hover:border-[#DC2626]/40 flex items-center justify-center text-gray-300 group-hover:text-[#DC2626] transition-colors shrink-0">
              <MapPin class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-bold text-white group-hover:text-amber-100 transition-colors">
                IPTV {city.name}
              </h3>
              <span class="text-xs text-gray-400">
                {city.state}
              </span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-[11px] font-mono text-[#10B981] font-semibold px-2 py-0.5 rounded bg-[#10B981]/10 border border-[#10B981]/20">
              {city.ping}
            </span>
            <ArrowRight class="w-4 h-4 text-gray-500 group-hover:text-white group-hover:translate-x-1 transition-all" />
          </div>
        </a>
      ))}
    </div>

    <!-- DACH Strategy Note -->
    <div class="mt-10 p-5 rounded-2xl bg-[#12141D] border border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <Server class="w-6 h-6 text-[#F59E0B] shrink-0" />
        <div>
          <span class="text-sm font-bold text-white block">Auch verfügbar in Österreich (AT) und der Schweiz (CH)</span>
          <span class="text-xs text-gray-400">Vollständiger Zugriff auf alle DACH-Kanäle, österreichische und Schweizer Feeds.</span>
        </div>
      </div>
      <a
        href="/#pricing"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white/[0.06] hover:bg-white/[0.12] text-xs font-bold text-white border border-white/10 shrink-0"
      >
        <span>DACH-Tarife ansehen</span>
        <ArrowRight class="w-3 h-3 text-[#F59E0B]" />
      </a>
    </div>

  </div>
</section>
