---
import { MessageCircle, X, Clock, Gift } from 'lucide-astro';

const whatsappOfferUrl = "https://wa.me/213550592200?text=Hallo%21%20Ich%20m%C3%B6chte%20gerne%20das%20German%20IPTV%20Exit-Sonderangebot%20nutzen%3A%20Jetzt%20abonnieren%20und%201%20Monat%20kostenlos%20dazubekommen%21";
---

<div
  id="exit-popup"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
>
  <div class="relative w-full max-w-lg rounded-3xl bg-gradient-to-b from-[#1C1217] via-[#14121A] to-[#0B0C10] border-2 border-[#DC2626]/60 p-6 sm:p-8 shadow-[0_0_50px_rgba(220,38,38,0.35)] text-center transform scale-95 transition-transform duration-300 overflow-hidden">
    
    <!-- Top Ambient Accent -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-32 bg-[#DC2626]/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <!-- Close Button -->
    <button
      id="close-exit-popup"
      type="button"
      class="absolute top-4 right-4 p-2 rounded-full text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-[#DC2626]"
      aria-label="Angebot schließen"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Gift Icon Emblem -->
    <div class="mx-auto mb-4 w-16 h-16 rounded-2xl bg-gradient-to-br from-[#DC2626] to-[#991B1B] flex items-center justify-center shadow-[0_0_25px_rgba(220,38,38,0.5)]">
      <Gift class="w-8 h-8 text-white" />
    </div>

    <!-- Urgency Badge -->
    <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#DC2626]/20 border border-[#DC2626]/40 text-[#DC2626] text-[11px] font-black uppercase tracking-wider mb-3">
      <Clock class="w-3.5 h-3.5" />
      <span>Exklusiver Abschieds-Bonus</span>
    </div>

    <!-- Main Title -->
    <h2 id="exit-popup-title" class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-2">
      Warten Sie! Gehen Sie nicht mit leeren Händen
    </h2>

    <!-- Mandatory Offer Requirement -->
    <p class="text-lg sm:text-xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#F59E0B] mb-3">
      Jetzt abonnieren und 1 Monat gratis erhalten!
    </p>

    <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6">
      Sichern Sie sich sofortigen Zugriff auf alle deutschen Sender in kristallklarem 4K/8K, 7-Tage EPG Guide und Anti-Freeze 9.8™ ohne Vertragsbindung.
    </p>

    <!-- Highlights Checklist -->
    <div class="bg-black/40 rounded-2xl p-3.5 border border-white/5 mb-6 text-xs text-gray-300 space-y-2 text-left">
      <div class="flex items-center gap-2">
        <span class="text-[#10B981] font-bold">✓</span>
        <span>+1 voller Monat Streaming kostenlos zu Ihrem gewählten Paket</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[#10B981] font-bold">✓</span>
        <span>Sofortige Freischaltung in 2 Minuten via WhatsApp</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[#10B981] font-bold">✓</span>
        <span>Sichere Zahlung mit PayPal Käuferschutz</span>
      </div>
    </div>

    <!-- Primary Action Link directly to WhatsApp -->
    <a
      href={whatsappOfferUrl}
      target="_blank"
      rel="noopener noreferrer"
      id="exit-popup-cta"
      class="w-full inline-flex items-center justify-center gap-3 py-4 px-6 rounded-2xl bg-gradient-to-r from-[#DC2626] via-[#E11D48] to-[#B91C1C] text-white font-black text-sm uppercase tracking-wider shadow-[0_0_30px_rgba(220,38,38,0.5)] hover:scale-[1.02] transition-all duration-200"
      aria-label="1 Monat gratis auf WhatsApp sichern"
    >
      <MessageCircle class="w-5 h-5" />
      <span>1 Monat Gratis auf WhatsApp Sichern</span>
    </a>

    <button
      id="dismiss-exit-popup"
      type="button"
      class="mt-3 text-xs text-gray-500 hover:text-gray-300 transition-colors"
    >
      Nein danke, ich möchte auf 1 Monat gratis verzichten
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'iptv_de_exit_popup_shown_v1';
  const POPUP_COOLDOWN_MS = 24 * 60 * 60 * 1000; // Strictly once per 24 hours

  let exitPopupShown = false;
  const popup = document.getElementById('exit-popup');
  const closeBtn = document.getElementById('close-exit-popup');
  const dismissBtn = document.getElementById('dismiss-exit-popup');
  const ctaBtn = document.getElementById('exit-popup-cta');

  function isEligibleToShow(): boolean {
    if (exitPopupShown) return false;
    const lastShown = localStorage.getItem(STORAGE_KEY);
    if (lastShown) {
      const timePassed = Date.now() - parseInt(lastShown, 10);
      if (timePassed < POPUP_COOLDOWN_MS) {
        return false;
      }
    }
    return true;
  }

  function showPopup() {
    if (!isEligibleToShow()) return;
    if (popup) {
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      setTimeout(() => {
        popup.classList.remove('opacity-0');
        const modal = popup.querySelector('div');
        if (modal) modal.classList.remove('scale-95');
      }, 20);
      exitPopupShown = true;
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    }
  }

  function hidePopup() {
    if (popup) {
      popup.classList.add('opacity-0');
      const modal = popup.querySelector('div');
      if (modal) modal.classList.add('scale-95');
      setTimeout(() => {
        popup.classList.remove('flex');
        popup.classList.add('hidden');
      }, 300);
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    }
  }

  // Detect mouse leaving viewport at the top (Desktop exit intent)
  document.addEventListener('mouseleave', (e) => {
    if (e.clientY <= 10) {
      showPopup();
    }
  });

  // Mobile fallback: trigger after 40 seconds of browsing if not shown in 24h
  setTimeout(() => {
    showPopup();
  }, 40000);

  if (closeBtn) closeBtn.addEventListener('click', hidePopup);
  if (dismissBtn) dismissBtn.addEventListener('click', hidePopup);
  if (ctaBtn) ctaBtn.addEventListener('click', hidePopup);
</script>
