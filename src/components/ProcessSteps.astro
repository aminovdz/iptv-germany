---
import { ShoppingCart, Zap, Tv, CheckCircle2, Sparkles, MessageCircle } from 'lucide-astro';

const steps = [
  {
    step: "01",
    icon: ShoppingCart,
    title: "1. Paket oder Test Wählen",
    description: "Wählen Sie Ihr bevorzugtes IPTV-Paket (z.B. das 12-Monate Testsieger Angebot für 55 €) oder fordern Sie unseren unverbindlichen 24-Stunden Gratis-Test an.",
    badge: "Schritt 1",
    tag: "Dauer: 1 Minute"
  },
  {
    step: "02",
    icon: Zap,
    title: "2. Blitzschnelle Aktivierung",
    description: "Nach Bestätigung erhalten Sie Ihre persönlichen Zugangsdaten (M3U-Playlist-Link und Xtream Codes API) in unter 2 Minuten direkt über WhatsApp oder E-Mail.",
    badge: "Schritt 2",
    tag: "Aktivierung: < 2 Min."
  },
  {
    step: "03",
    icon: Tv,
    title: "3. Sofort Losstreamen",
    description: "Installieren Sie die empfohlene IPTV-App auf Ihrem Smart TV, Fire TV Stick oder Smartphone, geben Sie Ihre Daten ein und genießen Sie alle Sender in 4K & 8K.",
    badge: "Schritt 3",
    tag: "Live in 4K/8K"
  }
];
---

<section class="py-20 md:py-28 relative bg-[#0D0F17] border-t border-white/[0.06]" aria-labelledby="steps-heading">
  <!-- Glow Accent -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[350px] bg-gradient-to-r from-[#DC2626]/08 via-[#F59E0B]/08 to-[#2563EB]/08 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>Einfache Einrichtung · In 3 Schritten</span>
      </div>

      <h2 id="steps-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        So einfach funktioniert <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#F59E0B]">German IPTV</span>
      </h2>

      <p class="text-base sm:text-lg text-gray-400 font-normal leading-relaxed">
        Keine Techniker-Termine, keine Antennen auf dem Dach, keine komplizierte Hardware. In nur wenigen Klicks sind Sie startklar.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((item, index) => {
        const IconComponent = item.icon;
        return (
          <div class="relative rounded-3xl bg-[#12141D] border border-white/[0.08] hover:border-[#DC2626]/40 p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl flex flex-col justify-between group">
            
            <!-- Step Number Watermark -->
            <div class="absolute top-4 right-6 text-5xl font-black text-white/[0.04] group-hover:text-[#DC2626]/10 transition-colors pointer-events-none">
              {item.step}
            </div>

            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#1A1D2B] to-[#0B0C10] border border-[#DC2626]/30 flex items-center justify-center text-[#DC2626] group-hover:scale-110 transition-transform duration-300 shadow-[0_0_20px_rgba(220,38,38,0.2)]">
                  <IconComponent class="w-7 h-7" />
                </div>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-white/[0.05] border border-white/10 text-gray-300">
                  {item.tag}
                </span>
              </div>

              <h3 class="text-xl font-bold text-white mb-3 group-hover:text-amber-100 transition-colors">
                {item.title}
              </h3>

              <p class="text-sm text-gray-400 leading-relaxed">
                {item.description}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs text-gray-400">
              <span class="text-[#10B981] font-semibold flex items-center gap-1.5">
                <CheckCircle2 class="w-4 h-4" />
                Keine Vorkenntnisse nötig
              </span>
              <span class="text-gray-500 font-mono font-bold">0{index + 1}/03</span>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Quick Help Banner -->
    <div class="mt-12 text-center">
      <p class="text-xs sm:text-sm text-gray-400 inline-flex items-center gap-2">
        <span>Benötigen Sie Hilfe bei der Installation?</span>
        <a
          href="https://wa.me/213550592200?text=Hallo%2C%20ich%20brauche%20Hilfe%20bei%20der%20IPTV%20Einrichtung."
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#DC2626] hover:text-[#EF4444] font-bold underline inline-flex items-center gap-1"
        >
          <MessageCircle class="w-3.5 h-3.5 text-[#10B981]" />
          Kostenlose WhatsApp Einrichtungs-Hilfe
        </a>
      </p>
    </div>

  </div>
</section>
