---
import { Tv, Sparkles, MessageCircle, Menu, X, ArrowRight } from 'lucide-astro';
import { currentYear } from '../utils/date';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { name: 'Startseite', href: '/' },
  { name: '24h Testline', href: '/iptv-test/' },
  { name: 'IPTV Kaufen', href: '/iptv-kaufen/' },
  { name: 'Live Scores', href: '/livescore/' },
  { name: 'Preise', href: '/preise/' },
  { name: 'Türkçe', href: '/tr/iptv-satin-al/' },
  { name: 'Ratgeber', href: '/guides/' },
  { name: 'Kontakt', href: '/contact/' }
];

const whatsappUrl = "https://wa.me/213550592200?text=Hallo%2C%20ich%20m%C3%B6chte%20gerne%20meinen%20kostenlosen%2024-Stunden%20Test%20f%C3%BCr%20German%20IPTV%20anfordern.";
---

<header class="sticky top-0 z-50 w-full transition-all duration-300 bg-[#0B0C10]/90 backdrop-blur-xl border-b border-white/[0.08] shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
  <!-- Top Promotion Ticker -->
  <div class="bg-gradient-to-r from-[#DC2626]/20 via-[#F59E0B]/20 to-[#DC2626]/20 border-b border-[#DC2626]/25 text-center py-1.5 px-4 text-xs font-medium text-amber-300">
    <div class="flex items-center justify-center gap-2 max-w-7xl mx-auto flex-wrap sm:flex-nowrap">
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#DC2626] text-white uppercase tracking-wider">
        Aktion {currentYear}
      </span>
      <span class="text-gray-200 text-[11px] sm:text-xs">
        12 Monate für nur <strong class="text-white font-bold">55 €</strong> inkl. Premium Player App Lizenz!
      </span>
      <a href="/#pricing" class="inline-flex items-center gap-1 text-[#F59E0B] hover:text-amber-200 hover:underline font-semibold ml-1 text-xs">
        Angebot sichern <ArrowRight class="w-3 h-3" />
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#DC2626] rounded-lg p-1" aria-label="German IPTV — Zur Startseite">
        <div class="relative w-10 h-10 rounded-xl bg-gradient-to-br from-[#1A1D2B] to-[#0B0C10] border border-[#DC2626]/40 flex items-center justify-center shadow-[0_0_15px_rgba(220,38,38,0.25)] group-hover:border-[#DC2626] transition-colors">
          <Tv class="w-5 h-5 text-[#DC2626] group-hover:scale-110 transition-transform duration-300" />
          <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#10B981] ring-2 ring-[#0B0C10] animate-pulse"></span>
        </div>
        <div class="flex flex-col">
          <span class="font-black text-xl tracking-tight text-white flex items-center gap-1.5">
            GERMAN <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#F59E0B]">IPTV</span>
          </span>
          <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 -mt-1">
            Offizieller Provider DACH
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Hauptnavigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
              currentPath === link.href
                ? 'text-[#DC2626] bg-[#DC2626]/10 font-semibold'
                : 'text-gray-300 hover:text-white hover:bg-white/[0.04]'
            }`}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop Actions -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-white/[0.05] hover:bg-white/[0.1] text-gray-200 border border-white/10 transition-all hover:scale-[1.02]"
          aria-label="24-Stunden Test kostenlos über WhatsApp anfordern"
        >
          <MessageCircle class="w-4 h-4 text-[#10B981]" />
          <span>24h Gratis Test</span>
        </a>

        <a
          href="/#pricing"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-[#DC2626] to-[#B91C1C] hover:from-[#EF4444] hover:to-[#DC2626] text-white shadow-[0_0_20px_rgba(220,38,38,0.35)] transition-all duration-200 hover:scale-[1.03] active:scale-[0.98]"
          aria-label="IPTV Paket wählen und sofort freischalten"
        >
          <Sparkles class="w-4 h-4" />
          <span>Jetzt Kaufen</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-xl bg-white/[0.05] text-[#10B981] border border-white/10"
          aria-label="WhatsApp Support"
        >
          <MessageCircle class="w-5 h-5" />
        </a>

        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2.5 rounded-xl bg-white/[0.05] text-gray-300 hover:text-white border border-white/10 focus:outline-none focus:ring-2 focus:ring-[#DC2626]"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Hauptmenü öffnen"
        >
          <Menu id="menu-icon-open" class="w-6 h-6" />
          <X id="menu-icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/[0.08] bg-[#0E1017]/95 backdrop-blur-2xl px-4 pt-4 pb-6 space-y-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-4 py-3 rounded-xl text-base font-medium text-gray-200 hover:bg-white/[0.06] hover:text-white transition-colors"
      >
        {link.name}
      </a>
    ))}

    <div class="pt-4 border-t border-white/[0.08] flex flex-col gap-3">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3.5 rounded-xl text-sm font-bold uppercase tracking-wider bg-white/[0.06] text-white border border-white/10"
      >
        <MessageCircle class="w-4 h-4 text-[#10B981]" />
        <span>24h Kostenlos Testen</span>
      </a>

      <a
        href="/#pricing"
        class="flex items-center justify-center gap-2 w-full py-3.5 rounded-xl text-sm font-bold uppercase tracking-wider bg-gradient-to-r from-[#DC2626] to-[#B91C1C] text-white font-bold shadow-[0_0_20px_rgba(220,38,38,0.4)]"
      >
        <Sparkles class="w-4 h-4" />
        <span>IPTV Kaufen (Ab 8 €)</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking any link
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
